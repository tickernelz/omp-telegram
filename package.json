{
  "name": "@tickernelz/omp-telegram",
  "version": "0.3.18",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Telegram runtime adapter for OMP",
  "keywords": [
    "omp-package",
    "omp",
    "oh-my-pi",
    "telegram",
    "bot",
    "extension"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tickernelz/omp-telegram.git"
  },
  "homepage": "https://github.com/tickernelz/omp-telegram",
  "bugs": {
    "url": "https://github.com/tickernelz/omp-telegram/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=4 --test-reporter=dot tests/*.test.ts",
    "test:verbose": "node --experimental-strip-types --test --test-reporter=spec tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=peer",
    "audit:host": "npm audit",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run typecheck && npm test && npm run audit && npm run pack:check"
  },
  "files": [
    "index.ts",
    "api/",
    "lib/",
    "README.md",
    "AGENTS.md",
    "BACKLOG.md",
    "CHANGELOG.md",
    "docs/",
    "scripts/",
    "skills/",
    "screenshot.png"
  ],
  "exports": {
    ".": "./index.ts",
    "./inbound": "./api/inbound.ts",
    "./outbound": "./api/outbound.ts",
    "./delivery": "./api/delivery.ts",
    "./activity": "./api/activity.ts",
    "./updates": "./api/updates.ts",
    "./commands": "./api/commands.ts",
    "./sections": "./api/sections.ts",
    "./status": "./api/status.ts",
    "./voice": "./api/voice.ts",
    "./keyboard": "./api/keyboard.ts"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/tickernelz/omp-telegram/main/screenshot.png"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "image": "https://raw.githubusercontent.com/tickernelz/omp-telegram/main/screenshot.png"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": ">=17.4.2",
    "@oh-my-pi/pi-ai": ">=17.4.2",
    "@oh-my-pi/pi-coding-agent": ">=17.4.2",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
